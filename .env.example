# LLM Provider selection: 'gemini' or 'ollama'
LLM_PROVIDER=gemini

# Google Gemini Configuration (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Ollama Local Configuration (required if LLM_PROVIDER=ollama)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Database connection URL for PostgreSQL (used by Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/battleagents?schema=public"

# JWT configuration for secure player sessions
JWT_SECRET="cyberpunk-battle-agents-secret-token-key-2026"

